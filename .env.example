# Copy to .env and fill in real values. .env is gitignored.

# Where the demo system databases live, and where this service stores its own
# reports and traces. Relative paths are resolved from the working directory.
DATA_DIR=

# Default SQLAlchemy URL for this service's own database (optional).
# Left empty it uses <DATA_DIR>/lineage_app.sqlite.
# Example: mssql+pyodbc://user:pass@host/SQLEXPRESS?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=

# ODBC driver used for SQL Server systems. Leave empty to auto-detect the best
# Microsoft SQL Server driver installed on the machine (18 -> 17 -> SQL Server).
MSSQL_ODBC_DRIVER=

# Seconds to wait for a lineage connection to be established.
DB_CONNECT_TIMEOUT_SECONDS=10

# Maximum accepted PDF upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=20

# How many hops a single lineage trace may take before it is cut off, so a
# cycle in the published metadata cannot spin forever.
MAX_TRACE_DEPTH=32